{
  "name": "Python & Typescript",
  "image": "ghcr.io/prulloac/base:bullseye",

  // 👇 Features to add to the Dev Container. More info: https://containers.dev/implementors/features.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/itsmechlark/features/postgresql:1":  {},
    "ghcr.io/jayree/devcontainer-features/npm-registry:1": {}
  },

  // 👇 Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [5432, 8000],

  // 👇 Configure tool-specific properties.
  "customizations" : {
    "jetbrains" : {
      "settings": {
        "com.intellij:app:GeneralSettings.autoSaveIfInactive": true,
        "com.intellij:app:HttpConfigurable.use_proxy_pac": true,
        "com.intellij:app:Vcs-Log-App-Settings.show_changes_from_parents": true
      },
      "backend" : "IntelliJ"
    },
    "vscode" : {
      "settings" : {},
      "extensions" : []
    }
  },

  // 👇 Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
