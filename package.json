  },
  "homepage": "https://github.com/harblz/aba#readme",
  "dependencies": {
    "alpinejs": "^3.14.7",
    "htmx-ext-alpine-morph": "^2.0.0",
    "htmx-ext-head-support": "^2.0.3",
    "htmx-ext-response-targets": "^2.0.2",
    "htmx.org": "^1.9.12"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "bulma": "^1.0.3",
    "htmx-ext-debug": "^2.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
