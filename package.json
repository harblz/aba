{
  "name": "aba.rocks",
  "version": "2.0.0",
  "description": "ABA Rocks is an open-source web app for aspiring behavior analysts!",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "webpack --mode development --config webpack.dev.config.js",
    "prod": "webpack --mode development --config webpack.prod.config.js",
